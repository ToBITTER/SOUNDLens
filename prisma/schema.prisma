generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportType {
  weekly
  monthly
}

enum SnapshotType {
  daily
  weekly
  monthly
  yearly
}

enum JobStatus {
  queued
  running
  success
  failed
}

model User {
  id             String      @id @default(uuid())
  spotifyUserId   String      @unique
  email          String?     
  displayName    String
  avatarUrl      String?
  country        String?
  productType    String?
  connectedSince DateTime     @default(now())
  lastLoginAt    DateTime?    
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  sessions        Session[]
  spotifyTokens   SpotifyToken?
  userProviders   UserProvider[]
  listeningHistory ListeningHistory[]
  listeningSessions ListeningSession[]
  analyticsSnapshots AnalyticsSnapshot[]
  analyticsEvents  AnalyticsEvent[]
  reports         Report[]
  notifications   Notification[]
  jobRuns         JobRun[]
  playlists       Playlist[]
}

model Session {
  id             String   @id @default(uuid())
  userId         String
  sessionTokenHash String @unique
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  revokedAt      DateTime?
  ipAddress      String?
  userAgent      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Provider {
  id        String   @id @default(uuid())
  key       String   @unique
  name      String
  createdAt DateTime @default(now())

  userProviders UserProvider[]
  tracks        Track[]
  artists       Artist[]
  albums        Album[]
  playlists     Playlist[]
  listeningHistory ListeningHistory[]
}

model UserProvider {
  id              String   @id @default(uuid())
  userId          String
  providerId      String
  providerUserId  String
  connectedAt     DateTime @default(now())
  disconnectedAt  DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
}

model SpotifyToken {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  accessTokenEncrypted   String
  refreshTokenEncrypted  String
  expiresAt              DateTime
  scope                  String
  tokenType              String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Track {
  id               String   @id @default(uuid())
  providerId       String
  providerTrackId  String
  name             String
  durationMs       Int
  explicit         Boolean  @default(false)
  popularity       Int?
  releaseDate      DateTime?
  albumId          String?
  createdAt        DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  album    Album?   @relation(fields: [albumId], references: [id], onDelete: SetNull)
  trackArtists TrackArtist[]
  playlistTracks PlaylistTrack[]
  listeningHistory ListeningHistory[]

  @@unique([providerId, providerTrackId])
  @@index([name])
}

model Artist {
  id               String   @id @default(uuid())
  providerId       String
  providerArtistId String
  name             String
  imageUrl         String?
  popularity       Int?
  genresCached     Json?
  createdAt        DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  trackArtists TrackArtist[]
  albumArtists AlbumArtist[]
  artistGenres ArtistGenre[]

  @@unique([providerId, providerArtistId])
  @@index([name])
}

model Album {
  id               String   @id @default(uuid())
  providerId       String
  providerAlbumId  String
  name             String
  imageUrl         String?
  releaseDate      DateTime?
  totalTracks      Int?
  createdAt        DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tracks   Track[]
  albumArtists AlbumArtist[]

  @@unique([providerId, providerAlbumId])
  @@index([name])
}

model Genre {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique

  artistGenres ArtistGenre[]
}

model TrackArtist {
  trackId  String
  artistId String

  track  Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([trackId, artistId])
}

model AlbumArtist {
  albumId  String
  artistId String

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([albumId, artistId])
}

model ArtistGenre {
  artistId String
  genreId  String

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  genre  Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([artistId, genreId])
}

model Playlist {
  id                String   @id @default(uuid())
  providerId        String
  providerPlaylistId String
  userId            String?
  name              String
  description       String?
  imageUrl          String?
  ownerName         String?
  isPublic          Boolean  @default(false)
  tracksCount       Int?
  createdAt         DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  playlistTracks PlaylistTrack[]
  listeningHistory ListeningHistory[]

  @@unique([providerId, providerPlaylistId])
}

model PlaylistTrack {
  playlistId String
  trackId    String
  position   Int?

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
}

model ListeningHistory {
  id                String   @id @default(uuid())
  userId            String
  providerId        String
  trackId           String
  artistId          String?
  albumId           String?
  playlistId        String?
  playedAt          DateTime
  playedDurationMs  Int
  source            String
  isUniquePlay      Boolean  @default(true)
  createdAt         DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  playlist Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@index([userId, playedAt(sort: Desc)])
  @@index([userId, trackId, playedAt(sort: Desc)])
}

model ListeningSession {
  id           String   @id @default(uuid())
  userId       String
  startedAt    DateTime
  endedAt      DateTime?
  durationMs   Int
  trackCount   Int
  dayBucket    DateTime
  weekBucket   DateTime
  monthBucket  DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model AnalyticsSnapshot {
  id           String       @id @default(uuid())
  userId       String
  periodType   SnapshotType
  periodStart  DateTime
  periodEnd    DateTime
  metricsJson  Json
  insightsJson Json
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodType, periodStart])
}

model AnalyticsEvent {
  id          String   @id @default(uuid())
  userId      String
  eventType   String
  eventDate   DateTime
  payloadJson Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Report {
  id           String     @id @default(uuid())
  userId       String
  reportType   ReportType
  periodStart  DateTime
  periodEnd    DateTime
  title        String
  summaryJson  Json
  status       JobStatus  @default(queued)
  generatedAt  DateTime?
  sentAt       DateTime?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportType, periodStart])
}

model Notification {
  id              String   @id @default(uuid())
  userId          String
  notificationType String
  title           String
  body            String
  metadataJson    Json?
  readAt          DateTime?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobRun {
  id            String    @id @default(uuid())
  jobName       String
  userId        String?
  status        JobStatus @default(queued)
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  metadataJson  Json?
  createdAt     DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model JobLock {
  id         String   @id @default(uuid())
  jobName    String
  lockKey    String
  expiresAt  DateTime

  @@unique([jobName, lockKey])
}
